# Sui Network
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_STORY_NFT_PACKAGE_ID=

# Enoki (zkLogin + sponsored tx)
NEXT_PUBLIC_ENOKI_API_KEY=
ENOKI_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Walrus testnet
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# MemWal
NEXT_PUBLIC_MEMWAL_RELAYER_URL=https://relayer.memwal.ai
MEMWAL_ACCOUNT_ID=

# MiniMax (reused from EP project)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Prose engine — server-side only (NO NEXT_PUBLIC prefix). See src/lib/llm.ts.
# Fallback chain: NVIDIA NIM (Kimi) → Gemini → Groq. NVIDIA NIM is required and
# the chain works on NIM alone. GEMINI_API_KEY / GROQ_API_KEY are OPTIONAL
# fallbacks — leave empty to skip that provider; fill from WRAP to enable them.
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
