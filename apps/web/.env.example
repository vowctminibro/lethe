# Sui network
NEXT_PUBLIC_SUI_NETWORK=testnet
# lethe::artwork Move package (set after `sui client publish`)
NEXT_PUBLIC_ARTWORK_PACKAGE_ID=
# lethe_battle::battle Move package (vote dedup + resolve/close)
NEXT_PUBLIC_BATTLE_PACKAGE_ID=
# Flip to true once ::battle::vote AND ::battle::resolve_battle are on the Enoki allowlist
NEXT_PUBLIC_BATTLE_VOTE_ALLOWLISTED=false

# Enoki — zkLogin (Google sign-in) + sponsored (gasless) mint
# NEXT_PUBLIC_ENOKI_API_KEY enables sign-in; ENOKI_SECRET_KEY enables the
# server-side sponsor route. The mint target (NEXT_PUBLIC_ARTWORK_PACKAGE_ID
# ::artwork::mint) must also be added to the Enoki sponsorship allowlist.
NEXT_PUBLIC_ENOKI_API_KEY=
ENOKI_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Walrus testnet — artwork blobs (image storage; load-bearing)
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# MiniMax — image generation (image-01). Server-side only.
MINIMAX_API_KEY=

# ── Owned AI memory (memory::memory Move package on testnet) ──────────────
# Publish the package in contracts/memory, then set its id here. Gasless
# create/add_entry/grant/revoke go through the Enoki sponsor route above.
NEXT_PUBLIC_MEMORY_PACKAGE_ID=
# Flip true once memory::create + add_entry (+ grant/revoke) sponsor cleanly.
NEXT_PUBLIC_MEMORY_ALLOWLISTED=false
# Provider behind useMemory(): "manual" (Walrus + client-side enc, default) or "memwal".
NEXT_PUBLIC_MEMORY_PROVIDER=manual
# Server-only master secret for the AES-256-GCM Encryptor that protects entries
# before they hit (public) Walrus. Per-user key = HKDF(secret, ownerAddress).
# Generate any high-entropy string, e.g. `openssl rand -hex 32`. SEAL swap-point.
MEMORY_ENCRYPTION_SECRET=

# ── LLM (chat + on-chain memory derivation). SERVER-ONLY, free tiers. ─────
# The chat brain and the "Analyze my on-chain activity" wedge both run through
# the provider chain in src/lib/llm: Groq (default) → Gemini (fallback). Set at
# least ONE free key and the app works — nothing is hardcoded, nothing committed.
# Groq:   https://console.groq.com  (free, OpenAI-compatible, llama-3.3-70b)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com  (free, gemini-2.0-flash)
GEMINI_API_KEY=
